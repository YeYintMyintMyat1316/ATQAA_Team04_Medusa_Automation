{
  "info": {
    "name": "Team04_Medusa_API_Collection",
    "description": "Capstone Sprint 3 (Task 3.4.1) - initial catalog & admin endpoint verification. NOTE: guideline Request 2 path /store/variants returns 404 on Medusa v2.21; the real endpoint is /store/product-variants (see Prompt_Log hallucination audit).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_Storefront_Catalog",
      "item": [
        {
          "name": "Get Products List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Products array is not empty\", function () {",
                  "    pm.expect(pm.response.json().products).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "pm.environment.set(\"variantId\", pm.response.json().products[0].variants[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Get Product Variants",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Variants array is not empty\", function () {",
                  "    pm.expect(pm.response.json().variants).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishableKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/product-variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product-variants"
              ]
            },
            "description": "Guideline lists {{baseUrl}}/variants, which does not exist in Medusa v2 (HTTP 404). Corrected to /product-variants."
          }
        }
      ]
    },
    {
      "name": "02_Admin_Authentication",
      "item": [
        {
          "name": "Admin Login Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const token = pm.response.json().token;",
                  "pm.test(\"Token returned\", function () {",
                  "    pm.expect(token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.environment.set(\"apiToken\", token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{adminBaseUrl}}/auth/user/emailpass",
              "host": [
                "{{adminBaseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "emailpass"
              ]
            }
          }
        }
      ]
    }
  ]
}